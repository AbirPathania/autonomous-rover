<?xml version="1.0" ?>
<!--
  Test terrain world for the six-wheel rover.
  Includes: sun, ground plane, a drivable ramp (slope testing), and scattered
  obstacles (rocks/blocks) so the perception + planning stack has something to
  chew on. Kept light so it runs without a GPU in WSL2.
-->
<sdf version="1.6">
  <world name="rover_test_terrain">

    <!-- Physics: real-time capable defaults -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.8 1</background>
      <shadows>false</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ===================== Ramp for slope testing ===================== -->
    <model name="ramp">
      <static>true</static>
      <pose>4.0 0 0.0 0 -0.20 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 2.0 0.1</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 2.0 0.1</size></box>
          </geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== Obstacles ===================== -->
    <model name="rock_1">
      <static>true</static>
      <pose>2.0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>3.0 -1.8 0.3 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_1">
      <static>true</static>
      <pose>7.0 2.0 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.3 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.3 1.0</size></box></geometry>
          <material><ambient>0.35 0.3 0.25 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_field_3">
      <static>true</static>
      <pose>6.0 -2.5 0.2 0 0 1.1</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.6 0.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.6 0.4</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
