<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_gazebo</name>
  <version>0.0.1</version>
  <description>Gazebo Classic worlds and simulation launch files for the six-wheel rover.</description>
  <maintainer email="you@example.com">abipathania</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rover_description</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rover_localization</exec_depend>
  <exec_depend>rover_terrain</exec_depend>
  <exec_depend>rover_safety</exec_depend>
  <exec_depend>rover_hw_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
