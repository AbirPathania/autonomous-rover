<?xml version="1.0"?>
<!--
  Rover mission behaviour tree.

  Top-level Fallback:
    1. EmergencyReturn override  - if the mode is EmergencyReturn, abort and RTH.
    2. Autonomous mission (ReactiveSequence, re-ticked every cycle so threats and
       blind terrain are handled reactively while driving):
         a. Threat handling: if a threat is detected -> Stop, Mark (keepout ->
            Nav2 reroute), then clear the flag; otherwise pass through.
         b. Blind terrain: if the terrain is blind -> LaunchDrone; otherwise pass.
         c. Drive: get the active waypoint and NavigateToPose to it; when the
            queue is exhausted, ReturnToHome.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="root">

      <Sequence name="emergency_return">
        <IsMode mode="EmergencyReturn"/>
        <ReturnToHome/>
      </Sequence>

      <ReactiveSequence name="autonomous_mission">

        <Fallback name="threat_handling">
          <Inverter>
            <IsThreatDetected/>
          </Inverter>
          <Sequence name="stop_scan_mark_reroute">
            <StopMotion/>
            <MarkThreat/>
            <ClearThreatFlag/>
          </Sequence>
        </Fallback>

        <Fallback name="blind_terrain">
          <Inverter>
            <IsTerrainBlind/>
          </Inverter>
          <LaunchDrone/>
        </Fallback>

        <!-- ForceSuccess is load-bearing: it makes a FAILED navigation
             attempt look like SUCCESS to this Fallback, so the Fallback does
             NOT drop through to ReturnToHome. Without it the two branches
             fight: any transient nav failure (planner hiccup, a goal aborted
             while the costmap catches up) sent the rover home, that home goal
             preempted the waypoint goal, the next tick re-sent the waypoint
             goal which preempted the home goal, and so on; goals were
             cancelling each other every few seconds and none ever ran to
             completion, so the rover sat still while the logs happily
             reported it was navigating.

             ClearGoalFlag sits INSIDE the guarded sequence deliberately: it
             only runs when the navigation actually succeeded, so a failed
             attempt leaves have_goal set and the same waypoint is retried on
             the next tick rather than being silently skipped.

             ReturnToHome is now reachable only via GetNextWaypoint returning
             FAILURE, i.e. the waypoint queue is genuinely exhausted, which
             is what "return home" was always meant to mean. -->
        <Fallback name="drive">
          <Sequence name="follow_waypoint">
            <GetNextWaypoint x="{gx}" y="{gy}" yaw="{gyaw}"/>
            <ForceSuccess>
              <Sequence name="navigate_then_advance">
                <NavigateToPose x="{gx}" y="{gy}" yaw="{gyaw}"/>
                <ClearGoalFlag/>
              </Sequence>
            </ForceSuccess>
          </Sequence>
          <ReturnToHome/>
        </Fallback>

      </ReactiveSequence>

    </Fallback>
  </BehaviorTree>
</root>
