<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_bringup</name>
  <version>0.0.1</version>
  <description>Top-level launch files that compose the rover sub-systems (sim, teleop, and later localization/nav/mission).</description>
  <maintainer email="you@example.com">abipathania</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rover_description</exec_depend>
  <exec_depend>rover_gazebo</exec_depend>
  <exec_depend>rover_navigation</exec_depend>
  <exec_depend>rover_mission</exec_depend>
  <exec_depend>rover_detection</exec_depend>
  <exec_depend>rover_safety</exec_depend>
  <exec_depend>rover_hw_bridge</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
