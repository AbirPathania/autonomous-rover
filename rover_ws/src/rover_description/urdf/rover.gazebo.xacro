<?xml version="1.0"?>
<!--
  Gazebo Classic materials, physics surface properties, and sensor/actuator
  plugins for the six-wheel rover. Included from rover.urdf.xacro.

  Publishes:
    /points   sensor_msgs/PointCloud2   (3D LiDAR)
    /imu      sensor_msgs/Imu
    /camera/image_raw + camera_info
    /odom     nav_msgs/Odometry         (skid-steer diff drive)
    /joint_states                       (wheel encoders)
  Subscribes:
    /cmd_vel  geometry_msgs/Twist
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- When true, the wheel diff-drive plugin publishes the odom->base_footprint
       TF (fine for the bare sim). Set false when robot_localization's local EKF
       owns that transform (i.e. when the localization stack is running). -->
  <xacro:arg name="publish_wheel_odom_tf" default="true"/>

  <!-- Actuation command topic the "motors" (diff-drive plugin) obey. Default is
       cmd_vel for the bare sim. When the safety + hardware-bridge stack runs, the
       emulated MCU drives the motors, so this is set to /motor/cmd_vel and the
       Jetson's /cmd_vel is routed through safety -> bridge -> MCU first. -->
  <xacro:arg name="cmd_vel_topic" default="cmd_vel"/>

  <!-- ===================== RViz / visual materials ===================== -->
  <material name="rover_body">   <color rgba="0.25 0.28 0.30 1.0"/></material>
  <material name="rover_wheel">  <color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="rover_sensor"> <color rgba="0.90 0.55 0.10 1.0"/></material>

  <!-- ===================== Gazebo visual colours ====================== -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Wheel friction: high mu for skid-steer traction -->
  <xacro:macro name="wheel_gazebo" params="prefix">
    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>10.0</maxVel>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_gazebo prefix="front_left"/>
  <xacro:wheel_gazebo prefix="front_right"/>
  <xacro:wheel_gazebo prefix="mid_left"/>
  <xacro:wheel_gazebo prefix="mid_right"/>
  <xacro:wheel_gazebo prefix="rear_left"/>
  <xacro:wheel_gazebo prefix="rear_right"/>

  <gazebo reference="lidar_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="camera_link"><material>Gazebo/Orange</material></gazebo>

  <!-- Rocker-bogie linkage beams -->
  <gazebo reference="left_rocker_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="right_rocker_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="left_bogie_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="right_bogie_link"><material>Gazebo/Grey</material></gazebo>

  <!-- ===================== Skid-steer drive (3 wheel pairs) =========== -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <!-- The plugin's command subscription is hard-coded to "cmd_vel"; it does
             NOT read <command_topic>. Remap it so the emulated MCU can own the
             motors (cmd_vel_topic=/motor/cmd_vel when hw:=true, else cmd_vel). -->
        <remapping>cmd_vel:=$(arg cmd_vel_topic)</remapping>
      </ros>

      <num_wheel_pairs>3</num_wheel_pairs>

      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_joint>mid_left_wheel_joint</left_joint>
      <right_joint>mid_right_wheel_joint</right_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>0.60</wheel_separation>
      <wheel_separation>0.60</wheel_separation>
      <wheel_separation>0.60</wheel_separation>
      <wheel_diameter>0.30</wheel_diameter>
      <wheel_diameter>0.30</wheel_diameter>
      <wheel_diameter>0.30</wheel_diameter>

      <max_wheel_torque>40.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <!-- NOTE: gazebo_ros diff_drive publishes odometry on the hard-coded topic
           "odom"; <odometry_topic> is not read. odometry_frame/robot_base_frame
           ARE read. -->
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>$(arg publish_wheel_odom_tf)</publish_odom_tf>
      <!-- Wheel TF is published by robot_state_publisher from /joint_states; keep
           this false to avoid duplicate, conflicting transforms. -->
      <publish_wheel_tf>false</publish_wheel_tf>

      <update_rate>50.0</update_rate>
    </plugin>
  </gazebo>

  <!-- Publish joint states (wheel encoders) for robot_state_publisher -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <!-- Driven wheel joints -->
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>mid_left_wheel_joint</joint_name>
      <joint_name>mid_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <!-- Passive rocker-bogie pivots (needed so robot_state_publisher can
           compute correct TF for the articulated linkage) -->
      <joint_name>left_rocker_joint</joint_name>
      <joint_name>right_rocker_joint</joint_name>
      <joint_name>left_bogie_joint</joint_name>
      <joint_name>right_bogie_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ===================== 3D LiDAR ==================================== -->
  <!-- Uses CPU "ray" for portability (works without a GPU in WSL2).
       For higher fidelity / rate on a GPU host, change type to "gpu_ray". -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.30</min>
          <max>50.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== IMU ========================================= -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== Camera ====================================== -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <camera name="front_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
