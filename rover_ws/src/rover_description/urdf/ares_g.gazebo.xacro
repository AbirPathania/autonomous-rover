<?xml version="1.0"?>
<!--
  Gazebo Classic materials, surface physics, ros2_control plugin and the
  ARES-G sensor suite (L0.3 6.1). Included from ares_g.urdf.xacro.

  Actuation is via gazebo_ros2_control (controllers in ares_controllers.yaml);
  the four-wheel-steering kinematics node (rover_control) maps /cmd_vel onto the
  wheel-velocity + kingpin-position controllers and publishes /odom.

  Sensors (as-real-as-sim-allows):
    /points               PointCloud2  Livox Mid-360-class 360 x 59 deg LiDAR
    /imu                  Imu          VN-200-class (200 Hz, spec-like noise)
    /front_cam/*                       RealSense D455-class depth (RGB + depth + points)
    /left_cam/*, /rear_cam/*           RealSense D435i-class RGB
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Controller parameter file (also referenced by the ros2_control plugin) -->
  <xacro:arg name="controllers_file"
             default="$(find rover_control)/config/ares_controllers.yaml"/>

  <!-- Camera sensors need a GL/rendering context; disable them for headless
       gzserver on machines without a GPU (Codespaces) to avoid a crash. -->
  <xacro:arg name="enable_cameras" default="true"/>

  <!-- ===================== RViz visual materials ===================== -->
  <material name="ares_hull">   <color rgba="0.20 0.22 0.20 1.0"/></material>
  <material name="ares_wheel">  <color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="ares_link">   <color rgba="0.35 0.35 0.35 1.0"/></material>
  <material name="ares_steer">  <color rgba="0.55 0.55 0.10 1.0"/></material>
  <material name="ares_sensor"> <color rgba="0.90 0.55 0.10 1.0"/></material>
  <material name="ares_marker"> <color rgba="0.85 0.05 0.05 1.0"/></material>

  <!-- ===================== Gazebo visual colours ===================== -->
  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="lidar_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="imu_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="front_cam_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="left_cam_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="rear_cam_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="left_rocker_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="right_rocker_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="left_bogie_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="right_bogie_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="marker_link2"><material>Gazebo/Red</material></gazebo>

  <!-- Wheel friction: high mu for traction on the rocker-bogie -->
  <xacro:macro name="wheel_gazebo" params="prefix">
    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.3</mu1>
      <mu2>1.3</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>10.0</maxVel>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_gazebo prefix="front_left"/>
  <xacro:wheel_gazebo prefix="front_right"/>
  <xacro:wheel_gazebo prefix="mid_left"/>
  <xacro:wheel_gazebo prefix="mid_right"/>
  <xacro:wheel_gazebo prefix="rear_left"/>
  <xacro:wheel_gazebo prefix="rear_right"/>

  <!-- ===================== ros2_control plugin ===================== -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(arg controllers_file)</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>

  <!-- Passive rocker-bogie pivots are reported as state-only joints inside the
       ros2_control block, so joint_state_broadcaster publishes them and
       robot_state_publisher can build the articulated TF tree. -->

  <!-- ===================== LiDAR: Livox Mid-360 class (360 x 59 deg) ===================== -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="livox_mid360">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <!-- Mid-360 vertical FOV: -7 deg to +52 deg (59 deg total).
               24 layers keeps the CPU ray sensor light for headless sim. -->
          <vertical>
            <samples>24</samples>
            <resolution>1</resolution>
            <min_angle>-0.12217</min_angle>
            <max_angle>0.90757</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== IMU: VN-200 class ===================== -->
  <gazebo reference="imu_link">
    <sensor name="vn200_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== Cameras (need a GL context; toggle for headless) ===================== -->
  <xacro:if value="$(arg enable_cameras)">
  <!-- ===================== Forward depth camera: RealSense D455 class ===================== -->
  <gazebo reference="front_cam_link">
    <sensor type="depth" name="front_d455">
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <camera name="front_d455">
        <horizontal_fov>1.5184</horizontal_fov>   <!-- ~87 deg (D455) -->
        <image>
          <width>848</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="front_cam_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>front_cam</camera_name>
        <frame_name>front_cam_optical_link</frame_name>
        <min_depth>0.2</min_depth>
        <max_depth>20.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== Side + rear cameras: RealSense D435i class ===================== -->
  <xacro:macro name="d435i" params="name">
    <gazebo reference="${name}_link">
      <sensor type="camera" name="${name}_d435i">
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera name="${name}_d435i">
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>15.0</far>
          </clip>
        </camera>
        <plugin name="${name}_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
          </ros>
          <camera_name>${name}</camera_name>
          <frame_name>${name}_optical_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:d435i name="left_cam"/>
  <xacro:d435i name="rear_cam"/>
  </xacro:if>

</robot>
