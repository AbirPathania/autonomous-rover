<?xml version="1.0"?>
<!--
  Gazebo Classic materials, surface physics, drive/steering plugins and the
  ARES-G sensor suite (L0.3 6.1). Included from ares_g.urdf.xacro.

  Actuation: gazebo_ros diff-drive for the six wheels (motion + /odom) and the
  gazebo_ros joint_pose_trajectory plugin for the four steered kingpins + marker
  arm (commanded by the rover_control steering / marker nodes from /cmd_vel).
  diff-drive itself obeys /wheel_cmd_vel, not /cmd_vel directly: the
  kinematics node derives it so skid-steer and kingpin steering never both
  try to turn the chassis at once (see ares_kinematics_node.py).

  Sensors (as-real-as-sim-allows):
    /points               PointCloud2  Livox Mid-360-class 360 x 59 deg LiDAR
    /imu                  Imu          VN-200-class (200 Hz, spec-like noise)
    /front_cam/*                       RealSense D455-class depth (RGB + depth + points)
    /left_cam/*, /rear_cam/*           RealSense D435i-class RGB
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Motor command topic / odom-TF ownership (mirrors the baseline rover).
       Default obeys the kinematics-node-derived wheel command, not raw
       /cmd_vel, so diff-drive and kingpin steering can't double-turn it. -->
  <xacro:arg name="publish_wheel_odom_tf" default="true"/>
  <xacro:arg name="cmd_vel_topic" default="wheel_cmd_vel"/>

  <!-- Camera sensors need a GL/rendering context; disable them for headless
       gzserver on machines without a GPU (Codespaces) to avoid a crash. -->
  <xacro:arg name="enable_cameras" default="true"/>

  <!-- ===================== RViz visual materials ===================== -->
  <material name="ares_hull">   <color rgba="0.20 0.22 0.20 1.0"/></material>
  <material name="ares_wheel">  <color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="ares_link">   <color rgba="0.35 0.35 0.35 1.0"/></material>
  <material name="ares_steer">  <color rgba="0.55 0.55 0.10 1.0"/></material>
  <material name="ares_sensor"> <color rgba="0.90 0.55 0.10 1.0"/></material>
  <material name="ares_marker"> <color rgba="0.85 0.05 0.05 1.0"/></material>

  <!-- ===================== Gazebo visual colours ===================== -->
  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="lidar_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="imu_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="front_cam_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="left_cam_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="rear_cam_link"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="left_rocker_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="right_rocker_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="left_bogie_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="right_bogie_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="marker_link2"><material>Gazebo/Red</material></gazebo>

  <!-- Wheel friction: high mu for traction on the rocker-bogie -->
  <xacro:macro name="wheel_gazebo" params="prefix">
    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.3</mu1>
      <mu2>1.3</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>10.0</maxVel>
      <fdir1>1 0 0</fdir1>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_gazebo prefix="front_left"/>
  <xacro:wheel_gazebo prefix="front_right"/>
  <xacro:wheel_gazebo prefix="mid_left"/>
  <xacro:wheel_gazebo prefix="mid_right"/>
  <xacro:wheel_gazebo prefix="rear_left"/>
  <xacro:wheel_gazebo prefix="rear_right"/>

  <!-- ===================== Skid-steer drive (3 wheel pairs, ARES-G dims) ===================== -->
  <!-- Proven gazebo_ros plugin: reliable motion + /odom. Skid-steer is the L0.3
       degraded-mode fallback; the four kingpins add real steering on top. -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=$(arg cmd_vel_topic)</remapping>
      </ros>
      <num_wheel_pairs>3</num_wheel_pairs>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_joint>mid_left_wheel_joint</left_joint>
      <right_joint>mid_right_wheel_joint</right_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <!-- ARES-G: track 0.28 m (centre-centre), wheel dia 0.22 m -->
      <wheel_separation>0.28</wheel_separation>
      <wheel_separation>0.28</wheel_separation>
      <wheel_separation>0.28</wheel_separation>
      <wheel_diameter>0.22</wheel_diameter>
      <wheel_diameter>0.22</wheel_diameter>
      <wheel_diameter>0.22</wheel_diameter>
      <max_wheel_torque>40.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>$(arg publish_wheel_odom_tf)</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <update_rate>50.0</update_rate>
    </plugin>
  </gazebo>

  <!-- Joint states for ALL joints (wheels, steered kingpins, passive pivots,
       marker arm) so robot_state_publisher builds the full articulated TF. -->
  <gazebo>
    <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>mid_left_wheel_joint</joint_name>
      <joint_name>mid_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>left_bogie_steer_joint</joint_name>
      <joint_name>right_bogie_steer_joint</joint_name>
      <joint_name>left_rear_steer_joint</joint_name>
      <joint_name>right_rear_steer_joint</joint_name>
      <joint_name>left_rocker_joint</joint_name>
      <joint_name>right_rocker_joint</joint_name>
      <joint_name>left_bogie_joint</joint_name>
      <joint_name>right_bogie_joint</joint_name>
      <joint_name>marker_shoulder_joint</joint_name>
      <joint_name>marker_elbow_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Four-station steering + marker arm actuation. The kinematics node
       publishes a JointTrajectory on /set_joint_trajectory to position the four
       kingpins (Ackermann angles from /cmd_vel) and the 2-DOF marker arm. -->
  <gazebo>
    <plugin name="joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- ===================== LiDAR: Livox Mid-360 class (360 x 59 deg) ===================== -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="livox_mid360">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <!-- Mid-360 vertical FOV: -7 deg to +52 deg (59 deg total).
               24 layers keeps the CPU ray sensor light for headless sim. -->
          <vertical>
            <samples>24</samples>
            <resolution>1</resolution>
            <min_angle>-0.12217</min_angle>
            <max_angle>0.90757</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== IMU: VN-200 class ===================== -->
  <gazebo reference="imu_link">
    <sensor name="vn200_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.4e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== Cameras (need a GL context; toggle for headless) ===================== -->
  <xacro:if value="$(arg enable_cameras)">
  <!-- ===================== Forward depth camera: RealSense D455 class ===================== -->
  <gazebo reference="front_cam_link">
    <sensor type="depth" name="front_d455">
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <camera name="front_d455">
        <horizontal_fov>1.5184</horizontal_fov>   <!-- ~87 deg (D455) -->
        <image>
          <width>848</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="front_cam_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>front_cam</camera_name>
        <frame_name>front_cam_optical_link</frame_name>
        <min_depth>0.2</min_depth>
        <max_depth>20.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== Side + rear cameras: RealSense D435i class ===================== -->
  <xacro:macro name="d435i" params="name">
    <gazebo reference="${name}_link">
      <sensor type="camera" name="${name}_d435i">
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera name="${name}_d435i">
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>15.0</far>
          </clip>
        </camera>
        <plugin name="${name}_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
          </ros>
          <camera_name>${name}</camera_name>
          <frame_name>${name}_optical_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:d435i name="left_cam"/>
  <xacro:d435i name="rear_cam"/>
  </xacro:if>

</robot>
